<!--EXTERNAL_PROPERTIES: GITHUB_ACTIONS-->
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.7.2</Version>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <Authors>Ben Hutchison; f1owkang</Authors>
        <Copyright>© 2026 Ben Hutchison; f1owkang</Copyright>
        <Company>$(Authors)</Company>
        <RollForward>major</RollForward>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>YubiKey.ico</ApplicationIcon>
        <NeutralLanguage>en</NeutralLanguage>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DebugType>embedded</DebugType>
        <LangVersion>latest</LangVersion>
        <SatelliteResourceLanguages>en;zh-CN;zh-TW</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="YubiKey.ico" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="McMaster.Extensions.CommandLineUtils" Version="5.1.0" />
        <PackageReference Include="mwinapi" Version="0.3.0.6" />
        <PackageReference Include="TaskScheduler" Version="2.12.2" />
        <PackageReference Include="Unfucked.Windows" Version="0.0.1-beta.11" />
        <PackageReference Include="Workshell.PE.Resources" Version="4.0.0.147" />
    </ItemGroup>

    <ItemGroup>
        <!-- Provides System.Windows.Automation (UIAutomationClient), used to interact with the Windows FIDO dialogs -->
        <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources\LocalizedStrings.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="LocalizedStrings.resx" />
        <EmbeddedResource Update="Resources\LocalizedStrings.resx" Generator="ResXFileCodeGenerator" LastGenOutput="LocalizedStrings.Designer.cs" />
    </ItemGroup>

    <!-- Issue #6: embed every language's strings in the main assembly instead of satellite DLLs, so the single-file
         EXE does not extract 40+ language resource folders at first launch. WithCulture=false makes the SDK generate
         them as main-assembly resources (default names) rather than satellite assemblies. -->
    <Target Name="EmbedLanguageResourcesInMainAssembly" BeforeTargets="PrepareResourceNames">
        <ItemGroup>
            <EmbeddedResource Update="Resources\LocalizedStrings.*.resx">
                <WithCulture>false</WithCulture>
            </EmbeddedResource>
        </ItemGroup>
    </Target>
    <Target Name="RemoveEmbeddedSatelliteCopies" AfterTargets="CreateSatelliteAssemblies">
        <ItemGroup>
            <IntermediateSatelliteAssembliesWithTargetPath Remove="@(IntermediateSatelliteAssembliesWithTargetPath)"
                                                           Condition="'%(Filename)' == 'PasskeyPick.resources'" />
        </ItemGroup>
    </Target>

    <!-- framework-dependent sizing: the app never calls WinRT APIs (UIAutomation goes through the managed
         UIAutomationClient and window handling is Win32), so drop the ~24 MB Windows SDK projection from the
         single-file EXE. The runtime only probes it if a WinRT type is actually used at run time. -->
    <Target Name="ExcludeSdkProjectionFromSingleFile" AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'Microsoft.Windows.SDK.NET' or '%(Filename)' == 'WinRT.Runtime'" />
        </ItemGroup>
    </Target>

    <!-- With RuntimeIdentifiers set, ComputeResolvedFilesToPublishList re-adds the satellite copies even though
         RemoveEmbeddedSatelliteCopies dropped them from the intermediate list, and the single-file bundler then fails
         because those intermediate DLLs were never generated. Drop them from the publish list too. -->
    <Target Name="ExcludeSatelliteResourcesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'PasskeyPick.resources'" />
        </ItemGroup>
    </Target>

    <!-- Framework-dependent sizing: the single-file EXE carries only the app's managed code (~2 MB) and loads the
         .NET Desktop Runtime from the system, exactly like g-helper. Tiny, but the target machine needs the runtime.
         IncludeNativeLibrariesForSelfExtract bundles mwinapi's 3 KB native helper so the publish is a single file. -->
    <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
        <SelfContained>false</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(Configuration)' != 'Debug'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

</Project>